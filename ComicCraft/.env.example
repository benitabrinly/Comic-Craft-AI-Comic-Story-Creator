# Copy this file to ".env" and fill in your key. Never upload ".env" to GitHub.
GEMINI_API_KEY=your_key_here

# Optional overrides (defaults shown). Check AI Studio for current model names.
GEMINI_FLASH_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# auto | diffusers | gemini | placeholder
IMAGE_BACKEND=auto
SD_MODEL_ID=stable-diffusion-v1-5/stable-diffusion-v1-5
